# .env
# Remplis ces variables avec tes vraies valeurs.
# NE JAMAIS mettre ce fichier sur GitHub !

# URL de connexion PostgreSQL (donnée par ton collègue)
DATABASE_URL=postgresql://user:password@localhost:5432/vintedbot

# Clé secrète pour générer les tokens JWT (mets n'importe quelle longue chaîne)
JWT_SECRET=mets-une-longue-chaine-secrete-ici-ex-abc123xyz

# Clé API Anthropic pour l'analyse IA
ANTHROPIC_KEY=sk-ant-ta-cle-api-ici

# URL de ton frontend (pour le CORS)
FRONTEND_URL=https://vinted.octilabs.com

# Port du serveur (optionnel, 3000 par défaut)
PORT=3000

# bot/.env.example
# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS mettre .env sur GitHub !

# URL de ton API backend sur Coolify
API_URL=https://ton-backend.coolify.com

# Token JWT du bot (fais POST /api/auth/login avec un compte bot)
BOT_TOKEN=eyJhbGci...

# Paramètres du scan
MIN_DISCOUNT=40
SCAN_INTERVAL=5

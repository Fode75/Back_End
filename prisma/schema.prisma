// prisma/schema.prisma
// Définition des tables de la base de données

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  filters   Filter[]
  settings  Settings?
}

model Deal {
  id            Int      @id @default(autoincrement())
  name          String
  brand         String?
  price         Float
  originalPrice Float?
  score         Int      @default(0)
  condition     String?
  city          String?
  url           String?
  category      String?
  image         String?
  createdAt     DateTime @default(now())
}

model Filter {
  id       Int     @id @default(autoincrement())
  userId   Int
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  active   Boolean @default(true)
  brands   String?
  budget   Float?
  discount Int     @default(40)
  keywords String?
  sizes    String?
}

model Settings {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  minDiscount  Int     @default(40)
  minScore     Int     @default(70)
  scanInterval Int     @default(5)
  discord      Boolean @default(false)
  email        Boolean @default(true)
}

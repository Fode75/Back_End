# bot/.env — NE PAS METTRE SUR GITHUB
# Copier ce fichier : copy bot\.env.example bot\.env

# Backend local ou deploy (Coolify, etc.)
API_URL=http://localhost:3000

# Optionnel : token JWT utilisateur (POST /api/deals n'en a pas besoin)
BOT_TOKEN=

MIN_DISCOUNT=40
# Si Vinted ne renvoie pas de prix barre, filtre par score (etat + photos)
MIN_SCORE=50
# 0 = illimite
MAX_PRICE=0
SCAN_INTERVAL=5
KEYWORDS=jordan 1,north face,jacquemus,carhartt,new balance
